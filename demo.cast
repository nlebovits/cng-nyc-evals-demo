[419.786777, "o", "\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m 56 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[38;2;147;153;178;48;2;33;58;43m-- Cache only Goiás CAR plus a small window around the intentionally outlying\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m 57 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[38;2;147;153;178;48;2;33;58;43m-- ID-less point. cod_estado is a Parquet predicate and avoids a nationwide cache.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m 58 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[38;2;203;166;247;48;2;33;58;43mCREATE OR REPLACE\u001b[38;2;205;214;244;48;2;33;58;43m \u001b[38;2;203;166;247;48;2;33;58;43mTABLE\u001b[38;2;205;214;244;48;2;33;58;43m car_cache \u001b[38;2;137;180;250;48;2;33;58;43mAS\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m 59 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[38;2;203;166;247;48;2;33;58;43mSELECT\u001b[38;2;205;214;244;48;2;33;58;43m cod_tema, nom_tema, cod_imovel, mod_fiscal, num_area, ind_status,\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m 60 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[38;2;205;214;244;48;2;33;58;43m       ind_tipo, des_condic, municipio, cod_estado, dat_criaca, dat_atuali,\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m 61 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[38;2;205;214;244;48;2;33;58;43m       geometry\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m 62 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[38;2;203;166;247;48;2;33;58;43mFROM\u001b[38;2;205;214;244;48;2;33;58;43m read_parquet(\u001b[38;2;166;227;161;48;2;33;58;43m'https://data.source.coop/tristangruppwri/cadastral/brazil-car-area-imove\u001b[39m\u001b[49