[816.6958, "o", "\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m116 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+    onEachFeature: (feature, shape) => {\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m117 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+      const p = feature.properties;\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m118 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+      const distance = p.contact_distance_m == null ? \"n/a\" : `${Number(p.contact_distance_\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mm).toLocaleString()} m`;\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m119 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+      shape.bindPopup(`\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m120 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+        <strong>${p.cod_imovel || \"Unresolved input\"}</strong><br>\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m121 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+        ${p.municipio || \"Município unavailable\"}<br>\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m122 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+        <b>Status:</b> ${p.assessment_status}<br>\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m123 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+        <b>Dominant class:</b> ${p.dominant_class || \"n/a\"}<br>\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m124 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+        <b>2021–2024 relevant loss:</b> ${Number(p.post2020_loss_ha || 0).toFixed(3)} ha<br\u001b[39m\u001b[49