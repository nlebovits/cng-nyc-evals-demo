[816.695869, "o", "\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m130 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+  const bounds = layer.getBounds();\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m131 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+  if (bounds.isValid()) map.fitBounds(bounds, {padding: [15, 15]});\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m132 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+  L.control.layers(null, {\"Portfolio properties\": layer}, {collapsed: false}).addTo(map);\u001b[39m\u001b[49m\u001b[0m\r\n"]
[816.696016, "o", "\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m133 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+  yield container;\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m134 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+}\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m135 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m136 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m137 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```{ojs}\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m138 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+map_view\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m139 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m140 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m141 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+## Method\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m142 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m143 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+### Property resolution\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m144 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m145 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+Each input row receives a stable row number and a submission hash. Exact duplicates are rep\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mresented once in the property analysis but their input row numbers and counts remain in the\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m results. Supplied CAR IDs are resolved by exact `cod_imovel`. ID-less points resolve by CA\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mR containment. ID-less polygons must cover at least 99.9% of a CAR and be at least 99.9% co\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mvered by it; this operationalizes the specification's “geometric match” as a near-exact, tw\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mo-way match rather than accepting any polygon located inside a CAR. Lowest `cod_imovel` is\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mthe deterministic tie-break.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m146 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m147 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+One polygon had axes swapped. Its original bounds were outside a conservative Brazil extent\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m (longitude −74 to −34, latitude −34 to 6) and its flipped bounds were inside, so it was re\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mpaired. No other geometry was changed. One input point at `POINT (-35 -10)` did not resolve\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m to a CAR and remains explicitly visible as `unresolved_geometry`.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m148 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m149 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```sql\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m150 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+-- The auditable implementation is in analysis.sql. Core axis rule:\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m151 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+CASE WHEN NOT original_in_brazil_extent AND flipped_in_brazil_extent\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m152 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+     THEN ST_FlipCoordinates(original_geometry)\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m153 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+     ELSE original_geometry END AS input_geometry\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m154 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m155 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+-- ID-less polygon match:\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m156 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+WHERE input_covered >= 0.999 AND car_covered >= 0.999\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m157 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m158 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m159 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+### Field matching and risk\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m160 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m161 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+All area operations use Brazil Polyconic **EPSG:5880**. A field qualifies if at least 0.667\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m of its area is in one listed CAR, or at least 0.667 is in the dissolved parcel union after\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m a 25 m buffer. Dissolving before intersection prevents overlap double-counting. Each match\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43med field is assigned to the parcel containing its largest area fraction; ties go to the low\u001b[39m\u001b[49m\u001b[0m\r\n"]
[816.696101, "o", "\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mest `cod_imovel`.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m162 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m163 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+Risk uses `deforestarea2124` and converts square metres to hectares by dividing by 10,000.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mA property is flagged when this value is positive for at least one matched field in classes\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m 15, 21, 35, 39, or 46. The dominant class is calculated from the total full-field area of\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m**all** matched fields, with the lowest `mbmode24` winning area ties.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m164 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m165 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```sql\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m166 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+matched = max_parcel_overlap_fraction >= 0.667\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m167 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+       OR buffered_union_overlap_fraction >= 0.667;\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m168 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m169 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+post2020_loss_ha = sum(deforestarea2124) / 10000.0;\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m170 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m171 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m172 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+The analysis matched 793 fields. A further 172 fields touched the buffered portfolio neighb\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43morhood but failed both 0.667 tests; these are retained in `field_match_diagnostics` and cou\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mnted in the audit summary rather than silently disappearing. Twenty-two properties had no m\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43matched field. Seventy-seven resolved properties had matched fields but no relevant post-202\u001b[39m\u001b[49m\u001b[0m\r\n"]
[816.696161, "o", "\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m0 loss.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m173 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m174 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+### Contact selection\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m175 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m176 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+The default candidate is the `membership_muni` cooperative whose entity ID equals the seven\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m-digit municipality code embedded in the resolved CAR ID. Applicable routed tiers come from\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m the dominant class. Coffee and palm oil have no facility coverage and no substitute is int\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mroduced. Distances are calculated from CAR centroid to facility in EPSG:5880. An `intake_po\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mint` or `slaughter_point` under 10,000 m overrides membership; a `mill_point` never does. C\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mandidate ordering is override eligibility, distance ascending, evidence value descending, t\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mhen entity ID ascending.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m177 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m178 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+Two properties receive facility overrides:\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m179 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m180 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```{ojs}\u001b[39m\u001b[49m\u001b[0m\r\n"]
[816.696227, "o", "\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m181 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+Inputs.table(flagged.filter(d => d.facility_override === true), {\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m182 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+  columns: [\"cod_imovel\", \"municipio\", \"post2020_loss_ha\", \"contact_entity_id\", \"contact_ti\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mer\", \"contact_distance_m\"],\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m183 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+  header: {cod_imovel: \"CAR property\", municipio: \"Município\", post2020_loss_ha: \"Loss (ha)\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m\", contact_entity_id: \"Contact ID\", contact_tier: \"Tier\", contact_distance_m: \"Distance (m)\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m\"}\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m184 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+})\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m185 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m186 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m187 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+## Audit and limitations\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m188 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m189 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```{ojs}\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m190 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+audit = FileAttachment(\"audit_summary.csv\").csv({typed: true})\u001b[39m\u001b[49m\u001b[0m\r\n"]
[816.696262, "o", "\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m191 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+Inputs.table(audit, {columns: [\"metric\", \"value\"], header: {metric: \"Audit metric\", value:\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m\"Count\"}, rows: 20})\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m192 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m193 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m194 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+- The input has 119 rows, one exact duplicate, and 118 unique analysis properties. The dupl\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43micate's two source rows remain listed on its result.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m195 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+- The unresolved point is not treated as low risk; it has no assessment and requires data c\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43morrection if it belongs in scope.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m196 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+- “Any value > 0” is applied exactly. Very small positive detections are therefore flagged;\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m no minimum mapping unit or materiality threshold was added.\u001b[39m\u001b[49m\u001b[0m\r\n"]
[816.69629, "o", "\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m197 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+- Field area means the full area of each qualified matched field, not only its intersection\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m with the parcel. This is the natural reading of “total matched-field area” and is stated h\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mere because it affects dominant class.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m198 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+- The coarse Brazil extent is used only for the narrowly constrained axis-repair test. It i\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43ms not used to resolve properties or assess risk.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m199 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+- Trazo3 is the specified Goiás layer. A successfully resolved property outside Goiás would\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m have no field coverage and would be reported as such, not inferred safe.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m200 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+- Contact IDs are dataset identifiers, not names or personal contact details. Operational t\u001b[39m\u001b[49m\u001b[0m\r\n"]
[816.696376, "o", "\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43meams should resolve the entity ID in their contact system before outreach.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m201 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m202 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+## Reproduce and inspect\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m203 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m204 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+Run the analysis from the project root with DuckDB 1.4.x and its bundled `spatial` and `htt\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43mpfs` extensions, then render the report:\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m205 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m206 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```bash\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m207 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+duckdb analysis.duckdb < analysis.sql\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m208 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+quarto render deforestation-risk-report.qmd\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m209 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+```\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m210 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m211 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+The complete executable SQL is [analysis.sql](analysis.sql). Supporting audit extracts are\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43m[property resolution](property_resolution.csv), [matched fields](matched_fields.csv), [prop\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43merty results](property_results.csv), and [audit summary](audit_summary.csv). The interactiv\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m     \u001b[22m\u001b[38;5;2;48;2;33;58;43me map reads [property GeoJSON](property_results.geojson).\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;48;2;33;58;43m\u001b[K\u001b[39;48;2;33;58;43m    \u001b[2m212 \u001b[22m\u001b[38;5;2;48;2;33;58;43m+\u001b[39m\u001b[49m\u001b[0m\r\n"]
